# ---- App ----
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allow-list. "*" is only acceptable in local development.
CORS_ORIGINS=*

# ---- Database ----
POSTGRES_USER=aijobagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aijobagent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Auth ----
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- AI Providers ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- Job Discovery ----
JOB_SEARCH_API_KEY=

# ---- Browser Automation ----
PLAYWRIGHT_HEADLESS=true

# ---- Object Storage ----
# Production on Vercel uses Supabase Storage; local development may use local storage.
DOCUMENT_STORAGE_BACKEND=local
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DOCUMENT_STORAGE_BUCKET=aijobagent-artifacts
DOCUMENT_STORAGE_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DOCUMENT_STORAGE_ROOT=data/documents

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=INFO
